{
  "name": "regiomovil",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && node scripts/prepare-catalog.mjs && node scripts/prepare-mobility.mjs && vite build && node scripts/finalize-web.mjs",
    "catalog:build": "node scripts/prepare-catalog.mjs",
    "mobility:build": "node scripts/prepare-mobility.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.tsx",
    "docs:check": "node scripts/check-docs.mjs",
    "model:train": "node server/train-model.mjs",
    "test:backend": "node --test tests/backend*.test.mjs",
    "admin:user": "node --env-file-if-exists=.env scripts/admin-user.mjs",
    "backup:reports": "node scripts/backup-reports.mjs",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:build": "node scripts/android-build.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.0.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/montserrat": "^5.2.0",
    "better-auth": "1.7.14",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
