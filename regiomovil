#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
runtime_root="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies"
if command -v node >/dev/null 2>&1; then
  app_node="$(command -v node)"
elif [[ -x "$runtime_root/node/bin/node" ]]; then
  app_node="$runtime_root/node/bin/node"
else
  echo "Instala Node.js 24 o posterior para ejecutar RegioMóvil." >&2
  exit 1
fi
export PATH="$(dirname "$app_node"):$PATH"
case "${1:-start}" in
  dev) exec "$app_node" scripts/dev.mjs ;;
  start) exec "$app_node" --env-file-if-exists=.env server/index.mjs ;;
  build) "$app_node" node_modules/typescript/bin/tsc -b; "$app_node" node_modules/vite/bin/vite.js build; exec "$app_node" scripts/finalize-web.mjs ;;
  test) exec "$app_node" --import tsx --test tests/*.test.mjs tests/*.test.tsx ;;
  android) exec "$app_node" scripts/android-build.mjs ;;
  *) echo "Uso: ./regiomovil [dev|start|build|test|android]" >&2; exit 1 ;;
esac
