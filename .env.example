# El piloto puede ejecutarse sin credenciales ni servicios externos.
HOST=127.0.0.1
PORT=3001
# Para Android instalado, usa un backend HTTPS. Se incorpora al compilar;
# nunca incluyas credenciales ni secretos en variables VITE_.
VITE_API_BASE_URL=
# Agrega aquí el dominio HTTPS de tu interfaz cuando se publique.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001,https://localhost,capacitor://localhost
# DATABASE_PATH=/ruta/persistente/regiomovil.sqlite
# Buscador del experimento: un solo proceso o un proxy con cuota compartida.
# Cambia el proveedor del lado servidor; el cliente no contiene credenciales.
PLACES_PROVIDER_URL=https://nominatim.openstreetmap.org/search
PLACES_USER_AGENT=RegioMovil/1.0 (https://github.com/GioMax102/RegioMovil)

# Autocompletado: Photon permite búsqueda al escribir. Nominatim público no.
# Para escalar, configura tu instancia Photon o proxy con cuota compartida.
PLACES_SUGGEST_PROVIDER_URL=https://photon.komoot.io/api/

# Administración independiente en /admin.html, mismo origen que la API.
# Mantener deshabilitada hasta aprovisionar cuentas y verificar HTTPS/MFA.
ADMIN_ENABLED=false
# ADMIN_ORIGIN=https://tu-api.example
# Generar con: openssl rand -base64 48. Nunca usar una clave del cliente VITE_.
# ADMIN_AUTH_SECRET=
# ADMIN_DATABASE_PATH=/ruta/privada/admin-auth.sqlite
# Sólo desarrollo HTTP en loopback, nunca NODE_ENV=production:
# ADMIN_ALLOW_INSECURE_LOCALHOST=true

# Monitoreo opcional: listener separado, autenticado y privado.
# Generar con: openssl rand -hex 32. Elegir TOKEN o TOKEN_FILE, no ambos.
# METRICS_TOKEN=
# METRICS_TOKEN_FILE=/ruta/privada/metrics_token
# METRICS_HOST=127.0.0.1
# METRICS_PORT=9091
