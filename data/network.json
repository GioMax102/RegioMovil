  "sources": [
    {
      "id": "nl-paradas-2025",
      "title": "Datos Abiertos NL · Paradas Oficiales STC Metrorrey (corte septiembre 2025)",
      "url": "https://catalogodatos.nl.gob.mx/dataset/paradas-oficiales-stc-metrorrey",
      "verifiedAt": "2026-10-15",
      "scope": "Coordenadas de 38 ubicaciones únicas, convertidas de grados/minutos/segundos a decimales. Son puntos aproximados de estación, no accesos peatonales. CSV publicado el 12 de noviembre de 2025."
    },
    {
      "id": "metrorrey-mapa-2026",
      "title": "Metrorrey · Mapa de Red (abril 2026)",
      "url": "https://www.metrorrey.mx/_files/ugd/f8686c_91419c4d7b504f9fab01aefc6a87412a.pdf",
      "verifiedAt": "2026-10-15",
      "scope": "Nombres, orden, correspondencias y colores de líneas 1, 2 y 3. Denomina Arena Monterrey a la estación Parque Fundidora del CSV. Líneas 4 y 6 figuran en construcción y se excluyen del grafo de demostración."
    },
    {
      "id": "metrorrey-servicio",
      "title": "Metrorrey · Horarios y medios de pago",
      "url": "https://www.metrorrey.mx/",
      "verifiedAt": "2026-10-15",
      "scope": "Horarios generales, medios de pago y consulta de avisos. La lista de elevadores/escaleras no confirma su funcionamiento actual; la accesibilidad operativa permanece sin verificar."
    },
    {
      "id": "metrorrey-tarifa-2026",
      "title": "Metrorrey · Imagen oficial de tarifa Metro",
      "url": "https://static.wixstatic.com/media/f8686c_2da39eabac874445986cbf9f59968fcd~mv2.png",
      "verifiedAt": "2026-10-15",
      "scope": "Imagen enlazada desde metrorrey.mx: tarifa Metro de 9.90 MXN al consultar. Referencia fechada, sujeta a cambios. RegioMovil no cobra pasajes."
    },
    {
      "id": "nl-guia-turistica-2025",
      "title": "Secretaría de Turismo NL · Guía turística Metrorrey",
      "url": "https://www.nl.gob.mx/sites/default/files/repositorio/Dependencias/Secretar%C3%ADa%20de%20Turismo/Micrositios/Guia_Sostenibilidad/20251113_guia_turistica_metrorrey.pdf",
      "verifiedAt": "2026-10-15",
      "scope": "Destinos y continuidad de Línea 2 a 3 por Zaragoza sin descender. Los destinos de búsqueda se anclan a una estación; no son un levantamiento de accesos."
    },
    {
      "id": "uanl-transporte-2023",
      "title": "UANL · Transporte público en Ciudad Universitaria",
      "url": "https://www.uanl.mx/wp-content/uploads/2023/03/Mesa-12-anexo.pdf",
      "verifiedAt": "2026-10-15",
      "scope": "Confirma conexión de Ciudad Universitaria con Universidad y Niños Héroes de Línea 2."
    },
    {
      "id": "nl-direcciones",
      "title": "Gobierno de Nuevo León · Directorio histórico de ubicaciones de estaciones",
      "url": "https://subasta.nl.gob.mx/docs/2_935.pdf",
      "verifiedAt": "2026-10-15",
      "scope": "Contraste de municipios para líneas 1 y 2. Referencia histórica sin validez para operación ni accesibilidad actuales."
    },
    {
      "id": "nl-infraestructura",
      "title": "Gobierno de Nuevo León · Anexo estadístico de infraestructura",
