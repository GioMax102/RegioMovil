{
  "id": null,
  "uid": "regiomovil-operacion",
  "title": "RegioMóvil · Operación",
  "description": "Métricas técnicas agregadas. Los umbrales de desarrollo deben calibrarse antes de producción. Sin contenido de reportes ni ubicaciones.",
  "tags": ["regiomovil"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(regiomovil_http_requests_total[5m]))",
          "legendFormat": "Solicitudes por segundo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Errores del servidor (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(regiomovil_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(regiomovil_http_requests_total[5m])), 0.001)",
          "legendFormat": "Errores del servidor (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Latencia p95 de API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(regiomovil_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "Latencia p95 de API"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Memoria del proceso",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "regiomovil_process_resident_bytes",
          "legendFormat": "Memoria del proceso"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU (núcleos)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(regiomovil_process_cpu_seconds_total[5m])",
          "legendFormat": "CPU (núcleos)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Retraso del bucle de eventos",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "regiomovil_event_loop_delay_seconds",
          "legendFormat": "Retraso del bucle de eventos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Cuota de reportes (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * regiomovil_reports_stored / regiomovil_reports_limit",
          "legendFormat": "Cuota de reportes (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Cuota de fotos (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "regiomovil-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * regiomovil_reports_photo_bytes / regiomovil_reports_photo_bytes_limit",
          "legendFormat": "Cuota de fotos (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "editable": false,
  "annotations": {
    "list": []
  }
}
