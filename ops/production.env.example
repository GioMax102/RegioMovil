# Template for a PRIVATE file on the VM, outside Git, mode 0600.
# Replace the reserved hostname in both origins and ops/Caddyfile.example.
# Compose interpolation only: pass this file with --env-file every time.
ADMIN_ENABLED=true
ADMIN_ORIGIN=https://regiomovil.example.org
ADMIN_ALLOW_INSECURE_LOCALHOST=false
# Generate a private value with openssl rand -hex 32 before starting.
# Empty means admin startup fails closed; do not use the example as-is.
ADMIN_AUTH_SECRET=
CORS_ORIGINS=https://regiomovil.example.org,https://localhost,capacitor://localhost
